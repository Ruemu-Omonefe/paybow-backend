PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/paybow
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Backend signing key (Ed25519). The backend signs public-key certificates / funding confirmations with it;
# the mobile app verifies them with the matching PUBLIC key embedded in mobile/src/config.ts.
# !! DEMO KEY ONLY – generate your own with:  npm run keygen   (then update the mobile app's SERVER_PUBLIC_KEY) !!
SERVER_SIGNING_SECRET_KEY=3FEYfdzLslnABU4YMbyvMohEpXHfOOFnHCNOeob2RGmZ8OdZvQTZNTX/OqhUKw0/SiT467mDEiIpQ3ter7ypXw==
CERT_VALIDITY_DAYS=30

# Limits (kobo). 10000 = NGN 100.00
MIN_AMOUNT_KOBO=10000
MAX_AMOUNT_KOBO=50000000
MIN_FUNDING_KOBO=10000
MAX_FUNDING_KOBO=50000000
MAX_QR_WINDOW_MS=600000
MAX_SYNC_AGE_MS=604800000
CLOCK_SKEW_MS=120000

# true ONLY when MongoDB runs as a replica set (wraps ledger entry + wallet change in one DB transaction)
USE_MONGO_TRANSACTIONS=false
